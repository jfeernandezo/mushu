# --- Core ---
NODE_ENV=development

# --- Mushu mode ---
# 'selfhost' (default) — billing UI hidden, all paid features unlocked, Stripe
#                        not required. This is what forks should use.
# 'hosted'             — billing UI active, Stripe required. The startup hook
#                        (apps/web/instrumentation.ts) refuses to boot if any
#                        STRIPE_* var below is missing.
# Anything other than the literal string 'hosted' is treated as 'selfhost'.
MUSHU_MODE=selfhost

# --- Database ---
DATABASE_URL=postgres://mushu:mushu@localhost:5432/mushu

# Optional: separate Postgres role for cross-tenant code (worker, webhook
# ingest, OAuth callback). Should be a role with BYPASSRLS so it can resolve
# events to the right organization. Falls back to DATABASE_URL if unset, which
# is fine for local dev where the same superuser runs everything. See
# SELF_HOSTING.md section 6 for the role split.
ADMIN_DATABASE_URL=

# --- Redis (BullMQ + cache) ---
REDIS_URL=redis://localhost:6379

# --- Better Auth ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# --- Meta / Instagram ---
# Facebook App ID/Secret — top of the dashboard at https://developers.facebook.com/apps/
# Used for: webhook signature verification (X-Hub-Signature-256).
META_APP_ID=
META_APP_SECRET=
# Instagram App ID/Secret — DIFFERENT from META_APP_ID. Find them at:
# Dashboard → your app → Instagram → "API setup with Instagram login" →
# "Instagram app ID" and "Instagram app secret".
# Used for: OAuth flow (instagram.com/oauth/authorize and token exchange).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# A random string you choose. Meta will send this back during webhook verification.
# Reused for both Instagram and Threads webhook subscriptions.
META_WEBHOOK_VERIFY_TOKEN=replace-me-with-random-token
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback

# --- Meta / Threads ---
# Threads is a SECOND Meta product registered under your Facebook App. In the
# App Dashboard, add the "Threads API" product, copy the Threads-specific
# app id and secret here, and configure the OAuth redirect URI to point at
# /api/oauth/threads/callback. Webhook subscriptions for `replies` and
# `mentions` go on the same App and reuse META_WEBHOOK_VERIFY_TOKEN above.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/threads/callback

# --- Encryption (for IG access tokens at rest) ---
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-me-with-64-hex-chars

# --- Sentry (error tracking) ---
# All variables are OPTIONAL — leave blank to disable error tracking.
# Server-side DSN (used by Next.js server runtime + worker process):
SENTRY_DSN=
# Client-side DSN (browser bundle). Usually the same DSN as above; Sentry
# distinguishes by the "platform" tag.
NEXT_PUBLIC_SENTRY_DSN=
# Trace sample rate 0.0–1.0. 0.1 = 10% of requests get a perf trace; events
# with errors are always sent regardless of this rate.
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Release identifier (e.g. git SHA). Lets Sentry group events by deploy and
# show "regressed in this release" headlines. Optional.
SENTRY_RELEASE=

# --- S3 / MinIO (media uploads) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=mushu
S3_SECRET_KEY=mushu-secret
S3_BUCKET=mushu-media
S3_REGION=us-east-1

# --- Public app URL (used in legal pages, OAuth callbacks, emails) ---
# Production should be the canonical https URL of YOUR deploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Legal / Company identity (REQUIRED in production) ---
# Each Mushu deployment is operated by a different legal entity. These vars
# identify the *controller of personal data* (LGPD) and the *service provider*
# in the Terms of Use, and they appear verbatim on /privacy, /terms and
# /data-deletion. If you fork or self-host Mushu, fill these with YOUR data —
# never ship with someone else's CNPJ. See SELF_HOSTING.md for details.
LEGAL_COMPANY_NAME=Sua Empresa LTDA
LEGAL_COMPANY_TRADE_NAME=Sua Marca
LEGAL_COMPANY_CNPJ=00.000.000/0001-00
LEGAL_COMPANY_ADDRESS=Rua Exemplo, 123, Bairro, Cidade/UF, CEP 00000-000
LEGAL_CONTACT_EMAIL=contato@seudominio.com
LEGAL_JURISDICTION=Comarca de São Paulo, SP, Brasil
# Date to display as "Vigência a partir de ..." on legal pages.
LEGAL_EFFECTIVE_DATE=25 de abril de 2026

# === Stripe (only set these if MUSHU_MODE=hosted) ===
# Self-hosted forks should leave this entire block empty. Setting these
# without MUSHU_MODE=hosted has no effect — billing routes stay 404.
#
# Get the secret + webhook secret from https://dashboard.stripe.com.
# Create one Product per plan ("Mushu Pro", "Mushu Agency"), then one
# recurring Price per Product (BRL, monthly), and copy the price IDs here.
# Free plan has no Stripe price — it's just a row in the `plan` table.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_AGENCY=

# === SMTP (required if MUSHU_MODE=hosted; optional in selfhost) ===
# Used for email verification, password reset, and workspace invitations.
# Configured for Hostinger by default — works with any standard SMTP provider.
#
# Selfhost forks: leave empty to disable email features. The app will warn
# in logs but continue to run; signup will skip email verification.
#
# Hostinger setup:
#   1. Create a mailbox in your Hostinger panel (e.g. noreply@seudominio.com)
#   2. Use that email and its password below
#   3. Confirm SPF and DKIM records are present in your DNS zone
#
# EMAIL_FROM's address part MUST match SMTP_USER (or SPF will fail and
# Hostinger will reject the message). The display name is free-form.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Mushu <noreply@seudominio.com>"
